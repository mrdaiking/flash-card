PORT=3000
APP_PIN=1234
DB_PATH=./data/cards.db
TOKEN_SECRET=change_this_to_random_string
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
REMINDER_HOUR_UTC=0

# End-of-day email digest (optional — skipped unless SMTP_HOST and DIGEST_TO are set).
# Any SMTP provider works, e.g. Gmail: smtp.gmail.com / 465 / your address / an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
DIGEST_TO=
DIGEST_FROM=
# Link placed in the email (optional).
APP_URL=
